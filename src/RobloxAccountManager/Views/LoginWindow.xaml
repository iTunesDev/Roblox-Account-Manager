<ui:FluentWindow x:Class="RobloxAccountManager.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sign in to Roblox" Width="560" Height="860" WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <DockPanel>
        <ui:TitleBar x:Name="Bar" DockPanel.Dock="Top" Title="Sign in to Roblox" ShowMinimize="False" />

        <!-- Sign-up helper: generated username and password -->
        <Border x:Name="GeneratorPanel" DockPanel.Dock="Top" Visibility="Collapsed" Margin="16,0,16,10" Padding="14" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="New account details" Style="{StaticResource CardTitle}" />
                <TextBlock Style="{StaticResource Caption}" Text="Generated for you. Edit them if you like, press Fill in, then pick a birthday and finish the form below. The password is saved to your vault." />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="GenUser" PlaceholderText="Username" Icon="{ui:SymbolIcon Person24}" LostFocus="OnUserEdited" />
                    <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon ArrowSync24}" ToolTip="New username" Click="OnNewUser" Margin="8,0,0,0" />
                </Grid>
                <TextBlock x:Name="UserStatus" Style="{StaticResource Caption}" Margin="4,4,0,0" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="GenPass" PlaceholderText="Password" Icon="{ui:SymbolIcon Key24}" FontFamily="Consolas" />
                    <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon ArrowSync24}" ToolTip="New password" Click="OnNewPass" Margin="8,0,0,0" />
                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Copy24}" ToolTip="Copy password" Click="OnCopyPass" Margin="8,0,0,0" />
                </Grid>
                <ui:Button Content="Fill in the form" Icon="{ui:SymbolIcon TextboxAlignTopLeft24}" Appearance="Primary" Click="OnFill" Margin="0,12,0,0" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Margin="16,0,16,10" Padding="12" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="ShieldLock24" Margin="0,0,10,0" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                <TextBlock x:Name="Header" Style="{StaticResource Caption}" Width="460"
                           Text="Sign in as normal. This window closes itself once you're in. The session and the password you typed are saved, encrypted, on this PC only." />
            </StackPanel>
        </Border>
        <wv2:WebView2 x:Name="Web" />
    </DockPanel>
</ui:FluentWindow>
