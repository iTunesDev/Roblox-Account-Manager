<ui:FluentWindow x:Class="RobloxAccountManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:svc="clr-namespace:RobloxAccountManager.Services"
        xmlns:local="clr-namespace:RobloxAccountManager"
        Title="Roblox Account Manager" Width="1240" Height="800" MinWidth="980" MinHeight="620"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <local:ShowIfConverter x:Key="ShowIf" />
        <local:ShowIfConverter x:Key="HideIf" Invert="True" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Roblox Account Manager" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= Sidebar ================= -->
            <DockPanel Grid.Column="0" Margin="12,4,8,12">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,0,18">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <ui:SymbolIcon Symbol="PeopleTeam24" Foreground="White" FontSize="18" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Account Manager" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="for Roblox" Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>

                <!-- Footer: live status -->
                <Border DockPanel.Dock="Bottom" CornerRadius="8" Padding="12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="RunningDot" Width="8" Height="8" Fill="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0" />
                            <TextBlock x:Name="RunningText" Text="0 running" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="UsageText" Text="CPU 0% · RAM 0 MB" Style="{StaticResource Caption}" Margin="16,2,0,0" />
                        <ui:ToggleSwitch x:Name="MultiBox" Content="Multiple windows" Margin="0,10,0,0"
                                         Checked="OnMultiChanged" Unchecked="OnMultiChanged" />
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton x:Name="NavAccounts" Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="True" Checked="OnNav" Tag="Accounts">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="People24" Margin="0,0,12,0" /><TextBlock Text="Accounts" /></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavLaunch" Style="{StaticResource NavItem}" GroupName="Nav" Checked="OnNav" Tag="Launch">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Rocket24" Margin="0,0,12,0" /><TextBlock Text="Launch" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Checked="OnNav" Tag="Servers">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Server24" Margin="0,0,12,0" /><TextBlock Text="Servers" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Checked="OnNav" Tag="Games">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Games24" Margin="0,0,12,0" /><TextBlock Text="Games" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Checked="OnNav" Tag="Presets">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Flash24" Margin="0,0,12,0" /><TextBlock Text="Presets" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Checked="OnNav" Tag="Monitor">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Gauge24" Margin="0,0,12,0" /><TextBlock Text="Monitor" /></StackPanel>
                    </RadioButton>
                    <Separator Margin="4,10" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Checked="OnNav" Tag="Settings">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Settings24" Margin="0,0,12,0" /><TextBlock Text="Settings" /></StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>

            <!-- ================= Content ================= -->
            <Border Grid.Column="1" CornerRadius="8,0,0,0" Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0">
                <DockPanel>
                    <!-- Status bar -->
                    <Border DockPanel.Dock="Bottom" Padding="24,10" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <ui:Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Stop" Icon="{ui:SymbolIcon Dismiss24}" Click="OnCancel" Visibility="Collapsed" />
                            <ui:ProgressRing x:Name="BusyRing" DockPanel.Dock="Left" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,10,0" Visibility="Collapsed" />
                            <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>

                    <Grid>
                        <!-- ========== ACCOUNTS ========== -->
                        <Grid x:Name="PageAccounts" Margin="24,20,24,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Content="Check logins" Icon="{ui:SymbolIcon ArrowSync24}" Click="OnValidateAll" Margin="0,0,8,0" />
                                    <ui:Button x:Name="AddButton" Content="Add account" Icon="{ui:SymbolIcon PersonAdd24}" Appearance="Primary" Click="OnAddMenu">
                                        <ui:Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Sign in with Roblox" Click="OnAddLogin" />
                                                <MenuItem Header="Create a new Roblox account" Click="OnCreateAccount" />
                                                <MenuItem Header="Paste a cookie" Click="OnAddCookie" />
                                                <MenuItem Header="Import cookies from a text file" Click="OnImportCookies" />
                                            </ContextMenu>
                                        </ui:Button.ContextMenu>
                                    </ui:Button>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Accounts" Style="{StaticResource PageTitle}" />
                                    <TextBlock x:Name="AccountsSummary" Text="No accounts yet" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DockPanel>

                            <DockPanel Grid.Row="1" Margin="0,16,0,12">
                                <ComboBox x:Name="GroupFilter" DockPanel.Dock="Right" Width="180" Margin="8,0,0,0" SelectionChanged="OnFilterChanged" />
                                <ui:TextBox x:Name="SearchBox" PlaceholderText="Search accounts" Icon="{ui:SymbolIcon Search24}" TextChanged="OnFilterChanged" />
                            </DockPanel>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="320" />
                                </Grid.ColumnDefinitions>

                                <ListBox x:Name="AccountList" SelectionMode="Extended" Background="Transparent" BorderThickness="0"
                                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="OnSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="44" Height="44">
                                                    <Border CornerRadius="22" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                        <Border.Clip><EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22" /></Border.Clip>
                                                        <Image Source="{Binding AvatarUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <Ellipse Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                             Fill="{DynamicResource SystemFillColorSuccessBrush}" Stroke="{DynamicResource SolidBackgroundFillColorBaseBrush}" StrokeThickness="2"
                                                             Visibility="{Binding IsRunning, Converter={StaticResource ShowIf}}" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <WrapPanel Margin="0,4,0,0">
                                                        <Border Style="{StaticResource Chip}">
                                                            <TextBlock Style="{StaticResource ChipText}" Text="{Binding StatusText}" />
                                                        </Border>
                                                        <Border Style="{StaticResource Chip}" Visibility="{Binding Group, Converter={StaticResource ShowIf}}">
                                                            <TextBlock Style="{StaticResource ChipText}" Text="{Binding Group}" />
                                                        </Border>
                                                        <Border Style="{StaticResource Chip}" Visibility="{Binding Region, Converter={StaticResource ShowIf}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon Symbol="Globe24" FontSize="11" Margin="0,0,4,0" />
                                                                <TextBlock Style="{StaticResource ChipText}" Text="{Binding Region}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Style="{StaticResource Chip}" Visibility="{Binding LowResource, Converter={StaticResource ShowIf}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon Symbol="LeafOne24" FontSize="11" Margin="0,0,4,0" />
                                                                <TextBlock Style="{StaticResource ChipText}" Text="Low-resource" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Style="{StaticResource Chip}" Visibility="{Binding AutoRejoin, Converter={StaticResource ShowIf}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="11" Margin="0,0,4,0" />
                                                                <TextBlock Style="{StaticResource ChipText}" Text="Auto-rejoin" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Style="{StaticResource Chip}" Visibility="{Binding Premium, Converter={StaticResource ShowIf}}">
                                                            <TextBlock Style="{StaticResource ChipText}" Text="Premium" />
                                                        </Border>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RobuxText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                    <ui:Button Icon="{ui:SymbolIcon Play24}" ToolTip="Launch into the game on the Launch page" Click="OnQuickLaunch" Tag="{Binding}"
                                                               Visibility="{Binding IsRunning, Converter={StaticResource HideIf}}" Appearance="Secondary" />
                                                    <ui:Button Icon="{ui:SymbolIcon Stop24}" ToolTip="Close this account's Roblox window" Click="OnQuickClose" Tag="{Binding}"
                                                               Visibility="{Binding IsRunning, Converter={StaticResource ShowIf}}" Appearance="Secondary" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Empty state -->
                                <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="PersonAdd24" FontSize="44" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="No accounts yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Add one with the button at the top right." Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                </StackPanel>

                                <!-- Details -->
                                <ui:Card Grid.Column="2" VerticalAlignment="Stretch" VerticalContentAlignment="Top" Padding="16">
                                    <Grid>
                                        <StackPanel x:Name="NoSelection" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock x:Name="SelectionHint" Text="Select an account to edit it." Style="{StaticResource Caption}" TextAlignment="Center" />
                                            <TextBlock Text="Ctrl or Shift click to select several." Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <ScrollViewer x:Name="DetailsPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                        <Border.Clip><EllipseGeometry Center="28,28" RadiusX="28" RadiusY="28" /></Border.Clip>
                                                        <Image Source="{Binding AvatarUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock Style="{StaticResource Caption}"><Run Text="@" /><Run Text="{Binding Username, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding RobuxText, Mode=OneWay}" /></TextBlock>
                                                    </StackPanel>
                                                </StackPanel>

                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Nickname" />
                                                <ui:TextBox Text="{Binding Alias, UpdateSourceTrigger=LostFocus}" PlaceholderText="e.g. Alt 3" LostFocus="OnDetailsEdited" />
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Group" />
                                                <ComboBox x:Name="GroupEdit" IsEditable="True" Text="{Binding Group, UpdateSourceTrigger=LostFocus}" LostFocus="OnDetailsEdited" />
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Server region" />
                                                <ComboBox ItemsSource="{x:Static svc:Regions.All}" SelectedItem="{Binding Region}" SelectionChanged="OnDetailsEdited" />
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Notes" />
                                                <ui:TextBox Text="{Binding Notes, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" LostFocus="OnDetailsEdited" />

                                                <ui:ToggleSwitch Content="Low-resource mode" IsChecked="{Binding LowResource}" Margin="0,16,0,0" Checked="OnDetailsEdited" Unchecked="OnDetailsEdited" />
                                                <TextBlock Text="Minimized, low priority, fewer CPU cores. Good for AFK." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                                <ui:ToggleSwitch Content="Auto-rejoin" IsChecked="{Binding AutoRejoin}" Margin="0,12,0,0" Checked="OnDetailsEdited" Unchecked="OnDetailsEdited" />
                                                <TextBlock Text="Relaunch if the window closes or gets disconnected." Style="{StaticResource Caption}" Margin="0,2,0,0" />

                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Last login check" />
                                                <TextBlock Text="{Binding LastValidated, StringFormat='{}{0:g}', TargetNullValue='Never'}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                                <ui:Button Content="Remove account" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Margin="0,20,0,0"
                                                           HorizontalAlignment="Stretch" Click="OnRemove" />
                                            </StackPanel>
                                        </ScrollViewer>
                                        <!-- Multi-select actions -->
                                        <StackPanel x:Name="MultiPanel" Visibility="Collapsed">
                                            <TextBlock x:Name="MultiTitle" Text="3 accounts selected" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="Changes here apply to all of them." Style="{StaticResource Caption}" />
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Set group" />
                                            <DockPanel>
                                                <ui:Button DockPanel.Dock="Right" Content="Apply" Click="OnBulkGroup" Margin="8,0,0,0" />
                                                <ComboBox x:Name="BulkGroup" IsEditable="True" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Set region" />
                                            <ComboBox x:Name="BulkRegion" ItemsSource="{x:Static svc:Regions.All}" SelectionChanged="OnBulkRegion" />
                                            <WrapPanel Margin="0,16,0,0">
                                                <ui:Button Content="Low-resource on" Click="OnBulkLowResOn" Margin="0,0,6,6" />
                                                <ui:Button Content="Off" Click="OnBulkLowResOff" Margin="0,0,6,6" />
                                            </WrapPanel>
                                            <WrapPanel>
                                                <ui:Button Content="Auto-rejoin on" Click="OnBulkRejoinOn" Margin="0,0,6,6" />
                                                <ui:Button Content="Off" Click="OnBulkRejoinOff" Margin="0,0,6,6" />
                                            </WrapPanel>
                                            <ui:Button Content="Remove selected" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Margin="0,14,0,0"
                                                       HorizontalAlignment="Stretch" Click="OnRemove" />
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                            </Grid>
                        </Grid>

                        <!-- ========== LAUNCH ========== -->
                        <ScrollViewer x:Name="PageLaunch" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="24,20,24,16" MaxWidth="880" HorizontalAlignment="Stretch">
                                <TextBlock Text="Launch" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="Pick a game, then send your selected accounts in." Style="{StaticResource Caption}" Margin="0,0,0,16" />

                                <ui:Card Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Game" Style="{StaticResource CardTitle}" />
                                        <DockPanel Margin="0,10,0,0">
                                            <ui:Button DockPanel.Dock="Right" Content="Look up" Click="OnLookupGame" Margin="8,0,0,0" />
                                            <ui:TextBox x:Name="PlaceBox" PlaceholderText="Place ID, game link, or private server link" LostFocus="OnPlaceLostFocus" />
                                        </DockPanel>
                                        <Border x:Name="GamePreview" Visibility="Collapsed" Margin="0,12,0,0" Padding="10" CornerRadius="6"
                                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                            <DockPanel>
                                                <ui:Button x:Name="FavButton" DockPanel.Dock="Right" Icon="{ui:SymbolIcon Star24}" ToolTip="Add to favorites" Click="OnToggleFavorite" VerticalAlignment="Center" />
                                                <Border Width="52" Height="52" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                    <Image x:Name="GameIcon" Stretch="UniformToFill" />
                                                </Border>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="GameName" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock x:Name="GameMeta" Style="{StaticResource Caption}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="200" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Server job ID (optional)" />
                                                <ui:TextBox x:Name="JobBox" PlaceholderText="Join one specific server" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Seconds between launches" />
                                                <ui:NumberBox x:Name="DelayBox" Minimum="0" Maximum="120" SmallChange="1" Value="8" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Padding="16" Margin="0,0,0,12">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ComboBox x:Name="QuickGroup" Width="160" Margin="0,0,8,0" ToolTip="Select every account in a group" SelectionChanged="OnQuickGroup" />
                                            <ui:Button Content="Select all" Click="OnSelectAll" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Accounts" Style="{StaticResource CardTitle}" />
                                            <TextBlock x:Name="LaunchSelection" Text="None selected. Pick them on the Accounts page." Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                </ui:Card>

                                <UniformGrid Columns="2" Margin="0,0,0,12">
                                    <ui:CardAction x:Name="LaunchButton" Margin="0,0,6,0" Icon="{ui:SymbolIcon Rocket24}" Click="OnLaunch">
                                        <StackPanel>
                                            <TextBlock Text="Launch separately" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="Each account joins its own server, matching its region if one is set." Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </ui:CardAction>
                                    <ui:CardAction x:Name="JoinButton" Margin="6,0,0,0" Icon="{ui:SymbolIcon PeopleTeam24}" Click="OnJoinTogether">
                                        <StackPanel>
                                            <TextBlock Text="Join same server" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="Everyone ends up together. If one is already in a game, the rest follow it." Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </ui:CardAction>
                                </UniformGrid>

                                <ui:Card Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Follow a friend" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Sends the selected accounts to the server a friend is in. Only works if their privacy settings let your accounts join them." Style="{StaticResource Caption}" />
                                        <DockPanel Margin="0,10,0,0">
                                            <ui:Button DockPanel.Dock="Right" Content="Follow" Icon="{ui:SymbolIcon PersonArrowRight24}" Click="OnFollowFriend" Margin="8,0,0,0" />
                                            <ui:TextBox x:Name="FriendBox" PlaceholderText="Friend's username" />
                                        </DockPanel>
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Padding="16">
                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Right" Content="Save as preset" Icon="{ui:SymbolIcon Flash24}" Click="OnSavePreset" VerticalAlignment="Center" />
                                        <StackPanel>
                                            <TextBlock Text="Save this setup" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="Keeps these accounts, this game and the join mode as a one-click preset." Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                </ui:Card>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ========== SERVERS ========== -->
                        <Grid x:Name="PageServers" Visibility="Collapsed" Margin="24,20,24,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Servers" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="Browse public servers of the game on the Launch page and send accounts to one." Style="{StaticResource Caption}" />
                            </StackPanel>
                            <DockPanel Grid.Row="1" Margin="0,16,0,12">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <ui:Button Content="Load servers" Icon="{ui:SymbolIcon ArrowSync24}" Click="OnLoadServers" Margin="0,0,8,0" />
                                    <ui:Button Content="Find regions" Icon="{ui:SymbolIcon Globe24}" Click="OnFindRegions" Margin="0,0,8,0" />
                                    <ui:Button Content="Send selected accounts" Icon="{ui:SymbolIcon Send24}" Appearance="Primary" Click="OnSendToServer" />
                                </StackPanel>
                                <TextBlock x:Name="ServersGame" Text="No game picked" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                            </DockPanel>
                            <DataGrid x:Name="ServerGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                      HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Players" Binding="{Binding Players}" Width="110" />
                                    <DataGridTextColumn Header="Ping" Binding="{Binding PingText}" Width="100" />
                                    <DataGridTextColumn Header="Region" Binding="{Binding Region}" Width="140" />
                                    <DataGridTextColumn Header="Job ID" Binding="{Binding JobId}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- ========== GAMES ========== -->
                        <ScrollViewer x:Name="PageGames" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="24,20,24,16">
                                <TextBlock Text="Games" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="Favorites and recently played. Click one to use it on the Launch page." Style="{StaticResource Caption}" Margin="0,0,0,16" />
                                <TextBlock Text="Favorites" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                <TextBlock x:Name="NoFavorites" Text="Star a game on the Launch page to pin it here." Style="{StaticResource Caption}" />
                                <ItemsControl x:Name="FavoriteGames">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:CardAction Width="250" Margin="0,0,12,12" Padding="12" IsChevronVisible="False" Click="OnUseGame" Tag="{Binding}">
                                                <DockPanel>
                                                    <Border Width="48" Height="48" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                        <Image Source="{Binding IconUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="{Binding PlaceId}" Style="{StaticResource Caption}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </ui:CardAction>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Margin="0,16,0,8">
                                    <ui:Button DockPanel.Dock="Right" Content="Clear" Click="OnClearRecent" />
                                    <TextBlock Text="Recent" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl x:Name="RecentGames" ItemTemplate="{Binding ItemTemplate, ElementName=FavoriteGames}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ========== PRESETS ========== -->
                        <ScrollViewer x:Name="PagePresets" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="24,20,24,16">
                                <TextBlock Text="Presets" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="One click launches a saved set of accounts into a saved game. Make one from the Launch page." Style="{StaticResource Caption}" Margin="0,0,0,16" />
                                <TextBlock x:Name="NoPresets" Text="No presets yet." Style="{StaticResource Caption}" />
                                <ItemsControl x:Name="PresetList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:Card Padding="16" Margin="0,0,0,8">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="Delete preset" Click="OnDeletePreset" Tag="{Binding Preset}" Margin="0,0,8,0" />
                                                        <ui:Button Content="Desktop shortcut" Icon="{ui:SymbolIcon Desktop24}" Click="OnPresetShortcut" Tag="{Binding Preset}" Margin="0,0,8,0" />
                                                        <ui:Button Content="Launch" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Click="OnRunPreset" Tag="{Binding Preset}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Preset.Name}" Style="{StaticResource CardTitle}" />
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </ui:Card>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ========== MONITOR ========== -->
                        <Grid x:Name="PageMonitor" Visibility="Collapsed" Margin="24,20,24,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Monitor" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="Live usage of every running account. Updates every few seconds." Style="{StaticResource Caption}" />
                            </StackPanel>
                            <UniformGrid Grid.Row="1" Columns="3" Margin="0,16,0,12">
                                <ui:Card Padding="16" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="Running" Style="{StaticResource Caption}" />
                                        <TextBlock x:Name="StatRunning" Text="0" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </ui:Card>
                                <ui:Card Padding="16" Margin="6,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="Total CPU" Style="{StaticResource Caption}" />
                                        <TextBlock x:Name="StatCpu" Text="0%" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </ui:Card>
                                <ui:Card Padding="16" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Total memory" Style="{StaticResource Caption}" />
                                        <TextBlock x:Name="StatRam" Text="0 MB" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </ui:Card>
                            </UniformGrid>
                            <WrapPanel Grid.Row="2" Margin="0,0,0,12">
                                <ui:Button Content="Tile windows" Icon="{ui:SymbolIcon Grid24}" Click="OnTile" Margin="0,0,8,0" ToolTip="Ctrl+Alt+T" />
                                <ui:Button x:Name="HideButton" Content="Hide all windows" Icon="{ui:SymbolIcon EyeOff24}" Click="OnToggleHide" Margin="0,0,8,0" ToolTip="Ctrl+Alt+H" />
                                <ui:Button Content="Server hop" Icon="{ui:SymbolIcon ArrowSwap24}" Click="OnServerHop" Margin="0,0,8,0"
                                           ToolTip="Move the selected accounts to a different server of the same game" />
                                <ui:Button Content="Optimize now" Icon="{ui:SymbolIcon LeafOne24}" Click="OnOptimizeNow" Margin="0,0,8,0" />
                                <ui:Button Content="Close selected" Icon="{ui:SymbolIcon Stop24}" Click="OnCloseSelected" Margin="0,0,8,0" />
                                <ui:Button Content="Close all Roblox" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Danger" Click="OnCloseAll" />
                            </WrapPanel>
                            <DataGrid x:Name="MonitorGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                                      HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Account" Binding="{Binding Title}" Width="*" />
                                    <DataGridTextColumn Header="CPU" Binding="{Binding Cpu, StringFormat='{}{0:0.0}%'}" Width="90" />
                                    <DataGridTextColumn Header="Memory" Binding="{Binding MemoryMb, StringFormat='{}{0:0} MB'}" Width="110" />
                                    <DataGridTextColumn Header="Uptime" Binding="{Binding UptimeText}" Width="100" />
                                    <DataGridCheckBoxColumn Header="Low-res" Binding="{Binding LowResource}" Width="80" />
                                    <DataGridCheckBoxColumn Header="Rejoin" Binding="{Binding AutoRejoin}" Width="80" />
                                    <DataGridTextColumn Header="PID" Binding="{Binding RunningPid}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- ========== SETTINGS ========== -->
                        <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="24,20,24,16" MaxWidth="880">
                                <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />

                                <ui:CardExpander Header="Performance" Icon="{ui:SymbolIcon Gauge24}" IsExpanded="True" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Max Roblox windows at once" Margin="0,0,0,6" />
                                                <ui:NumberBox x:Name="MaxClientsBox" Minimum="1" Maximum="100" SmallChange="1" LostFocus="OnSettingNumber" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="CPU cores per low-resource window" Margin="0,0,0,6" />
                                                <ui:NumberBox x:Name="CoresBox" Minimum="1" Maximum="64" SmallChange="1" LostFocus="OnSettingNumber" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Trim memory every (min, 0 = off)" Margin="0,0,0,6" />
                                                <ui:NumberBox x:Name="TrimBox" Minimum="0" Maximum="60" SmallChange="1" LostFocus="OnSettingNumber" />
                                            </StackPanel>
                                        </Grid>
                                        <ui:ToggleSwitch x:Name="MinimizeBox" Content="Minimize low-resource windows when they open" Margin="0,14,0,0"
                                                         Checked="OnSettingToggle" Unchecked="OnSettingToggle" />
                                    </StackPanel>
                                </ui:CardExpander>

                                <ui:CardExpander Header="Auto-rejoin" Icon="{ui:SymbolIcon ArrowClockwise24}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Wait before rejoining (seconds)" Margin="0,0,0,6" />
                                                <ui:NumberBox x:Name="RejoinDelayBox" Minimum="5" Maximum="600" SmallChange="5" LostFocus="OnSettingNumber" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Give up after this many tries in a row" Margin="0,0,0,6" />
                                                <ui:NumberBox x:Name="RejoinMaxBox" Minimum="1" Maximum="50" SmallChange="1" LostFocus="OnSettingNumber" />
                                            </StackPanel>
                                        </Grid>
                                        <ui:ToggleSwitch x:Name="RejoinDisconnectBox" Content="Also rejoin when the window is open but the account dropped out of the game"
                                                         Margin="0,14,0,0" Checked="OnSettingToggle" Unchecked="OnSettingToggle" />
                                    </StackPanel>
                                </ui:CardExpander>

                                <ui:CardExpander Header="Discord alerts" Icon="{ui:SymbolIcon Alert24}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Create a webhook in your Discord server (Server settings, Integrations, Webhooks) and paste its URL here." Style="{StaticResource Caption}" />
                                        <DockPanel Margin="0,10,0,0">
                                            <ui:Button DockPanel.Dock="Right" Content="Send test" Click="OnTestWebhook" Margin="8,0,0,0" />
                                            <ui:PasswordBox x:Name="WebhookBox" PlaceholderText="https://discord.com/api/webhooks/..." LostFocus="OnSettingText" />
                                        </DockPanel>
                                        <ui:ToggleSwitch x:Name="NotifyDisconnectBox" Content="Alert when an account drops out" Margin="0,14,0,0" Checked="OnSettingToggle" Unchecked="OnSettingToggle" />
                                        <ui:ToggleSwitch x:Name="NotifyRejoinBox" Content="Alert when an account is rejoined" Margin="0,10,0,0" Checked="OnSettingToggle" Unchecked="OnSettingToggle" />
                                    </StackPanel>
                                </ui:CardExpander>

                                <ui:CardExpander Header="App" Icon="{ui:SymbolIcon Window24}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <ui:ToggleSwitch x:Name="TrayBox" Content="Keep running in the tray when the window is closed" Checked="OnSettingToggle" Unchecked="OnSettingToggle" />
                                        <ui:ToggleSwitch x:Name="HotkeysBox" Content="Global hotkeys" Margin="0,10,0,0" Checked="OnSettingToggle" Unchecked="OnSettingToggle" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                                   Text="Ctrl+Alt+H hide or show all Roblox windows · Ctrl+Alt+T tile them · Ctrl+Alt+M show this app" />
                                        <ui:ToggleSwitch x:Name="StartupBox" Content="Start with Windows (in the tray)" Margin="0,10,0,0" Checked="OnStartupToggle" Unchecked="OnStartupToggle" />
                                        <DockPanel Margin="0,8,0,0">
                                            <TextBlock Text="Then launch preset" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <ComboBox x:Name="StartupPresetBox" Width="240" HorizontalAlignment="Left" DisplayMemberPath="Name" SelectionChanged="OnStartupPresetChanged" />
                                        </DockPanel>
                                        <ui:ToggleSwitch x:Name="TitlesBox" Content="Show the account name in each Roblox window's title" Margin="0,10,0,0" Checked="OnSettingToggle" Unchecked="OnSettingToggle" />
                                        <ui:ToggleSwitch x:Name="LightBox" Content="Light theme" Margin="0,10,0,0" Checked="OnThemeToggle" Unchecked="OnThemeToggle" />
                                    </StackPanel>
                                </ui:CardExpander>

                                <ui:Card Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Your data" Style="{StaticResource CardTitle}" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                                   Text="Logins are encrypted with Windows (DPAPI) and only this Windows user on this PC can read them. Nothing is uploaded anywhere. Region lookups send Roblox server addresses, never your data, to ip-api.com." />
                                        <ui:Button Content="Open data folder" Icon="{ui:SymbolIcon Folder24}" Click="OnOpenDataFolder" Margin="0,12,0,0" />
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
